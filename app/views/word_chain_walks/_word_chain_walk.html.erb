<% latest_step = word_chain_walk.latest_step %>
<% finished = word_chain_walk.finished? %>

<article id="<%= dom_id word_chain_walk %>">
  <%= link_to word_chain_walk, class: ["walk-index-card", (finished ? "walk-index-card-finished" : "walk-index-card-active")] do %>
    <% if latest_step&.image&.attached? %>
      <%= image_tag latest_step.image,
                    alt: "「#{word_chain_walk.start_char}」から始まった散歩の写真",
                    class: "walk-index-card-image" %>
    <% else %>
      <div
        class="walk-index-card-image walk-index-no-image"
        role="img"
        aria-label="写真はありません。"
      >
        写真はまだありません。
      </div>
    <% end %>

    <div class="walk-index-card-content">
      <span class="walk-index-status <%= finished ? "walk-index-status-finished" : "walk-index-status-active" %>">
        <%= finished ? "完了" : "進行中" %>
      </span>

      <p class="walk-index-card-title">
        <%= word_chain_walk.started_at.strftime("%Y年%-m月%-d日 %H:%M") %>の散歩
      </p>

      <dl class="walk-index-card-meta">
        <div>
          <dt class="sr-only">最初の文字</dt>
          <dd>「<%= word_chain_walk.start_char %>」から</dd>
        </div>

        <div>
          <dt class="sr-only">つないだことばの数</dt>
          <dd><%= word_chain_walk.word_chain_walk_steps.size %>個のことば</dd>
        </div>

        <div>
          <dt class="sr-only">かかった時間</dt>

          <dd>
            <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
          </dd>
        </div>
      </dl>

      <% unless finished %>
        <p class="walk-index-resume">
          続きから歩く <span aria-hidden="true">→</span>
        </p>
      <% end %>
    </div>
  <% end %>
</article>
