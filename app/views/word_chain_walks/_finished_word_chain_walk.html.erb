<% latest_step = word_chain_walk.word_chain_walk_steps.max_by(&:id) %>

<div id="<%= dom_id word_chain_walk %>">
  <%= link_to word_chain_walk, class: "home-recent-card" do %>
    <span class="home-recent-start-char">「<%= word_chain_walk.start_char %>」から</span>
    <% if latest_step %>
      <%= image_tag latest_step.image,
                    alt: "「#{word_chain_walk.start_char}」から始まった散歩の写真",
                    class: "home-recent-image" %>
    <% else %>
      <div
        class="home-recent-image home-recent-no-image"
        role="img"
        aria-label="写真はありません。"
      >
        写真はまだありません。
      </div>
    <% end %>

    <div class="home-recent-card-body">
      <p class="home-recent-word">
        <%= word_chain_walk.started_at.strftime("%Y年%-m月%-d日 %H:%M") %>の散歩
      </p>
    </div>

    <dl class="home-recent-stats">
      <div>
        <dt class="sr-only">つないだことばの数</dt>

        <dd>
          <%= word_chain_walk.word_chain_walk_steps.size %>個のことば
        </dd>
      </div>

      <div>
        <dt class="sr-only">かかった時間</dt>

        <dd>
          <%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %>
        </dd>
      </div>
    </dl>
  <% end %>
</div>
