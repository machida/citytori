<% content_for :title, "散歩一覧" %>

<% finished_word_chain_walks, active_word_chain_walks = @word_chain_walks.partition(&:finished?) %>

<main class="walk-index-page">
  <div class="walk-index-content">
    <h1 class="walk-index-title">散歩一覧</h1>

    <% if active_word_chain_walks.any? %>
      <section
        class="walk-index-section"
        aria-labelledby="active-walks-heading"
      >
        <h2 id="active-walks-heading" class="walk-index-heading">
          <i
            class="
              fa-solid fa-camera walk-index-heading-icon
              walk-index-heading-icon-active
            "
            aria-hidden="true"
          ></i>
          進行中の散歩
        </h2>

        <div class="walk-index-list">
          <% active_word_chain_walks.each do |word_chain_walk| %>
            <%= render "word_chain_walks/word_chain_walk", word_chain_walk: %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if finished_word_chain_walks.any? %>
      <section
        class="walk-index-section"
        aria-labelledby="finished-walks-heading"
      >
        <h2 id="finished-walks-heading" class="walk-index-heading">
          <i
            class="
              fa-solid fa-book-open walk-index-heading-icon
              walk-index-heading-icon-finished
            "
            aria-hidden="true"
          ></i>
          これまでの散歩
        </h2>

        <div class="walk-index-list">
          <% finished_word_chain_walks.each do |word_chain_walk| %>
            <%= render "word_chain_walks/word_chain_walk", word_chain_walk: %>
          <% end %>
        </div>
      </section>
    <% elsif active_word_chain_walks.empty? %>
      <section
        class="walk-index-empty"
        aria-labelledby="finished-walks-heading"
      >
        <h2 id="finished-walks-heading" class="walk-index-heading">
          <i
            class="
              fa-solid fa-book-open walk-index-heading-icon
              walk-index-heading-icon-finished
            "
            aria-hidden="true"
          ></i>
          これまでの散歩
        </h2>

        <p>まだ散歩の記録はありません</p>

        <%= button_to "散歩を始める",
                      word_chain_walks_path,
                      method: :post,
                      class: "walk-index-start-button" %>
      </section>
    <% end %>
  </div>
</main>
