<% allowed_start_chars = word_chain_walk.allowed_start_chars %>

<% if allowed_start_chars.any? %>
  <div class="active-walk-allowed-chars">
    <div class="active-walk-allowed-icon">
      <i class="fa-solid fa-check" aria-hidden="true"></i>
    </div>

    <p>
      <span><%= formatted_allowed_start_chars(allowed_start_chars) %></span>
      から始まる言葉でもOKです
    </p>
  </div>
<% end %>
