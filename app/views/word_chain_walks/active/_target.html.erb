<section id="word_chain_walk_target" class="walk-target-section">
  <h2 class="walk-target-heading">
    街の中で見つけよう！
  </h2>

  <div class="walk-target-visual">
    <%= image_tag "street-line-step.png",
                  class: "walk-target-street-image",
                  alt: "街灯や木、建物が並ぶ街並み" %>

    <div class="walk-target-char-card">
      <span class="walk-target-char"><%= word_chain_walk.target_char %></span>
    </div>
  </div>

  <p class="walk-target-copy">
    に続く言葉を
    <br>
    街の中から見つけましょう
  </p>

  <%= render "word_chain_walks/active/allowed_start_chars", word_chain_walk: word_chain_walk %>
</section>
