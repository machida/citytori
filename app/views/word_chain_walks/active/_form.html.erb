<section class="active-walk-photo-section">
  <%= form_with(
    model: [word_chain_walk, word_chain_walk_step],
    data: {
      controller: "modal previews geolocation form",
      modal_target: "form",
      action: "
        previews:file-selected->modal#open
        previews:file-selected->geolocation#fetchPosition
        turbo:submit-end->modal#closeIfSubmitSuccess
        modal:reset->previews#removeImage
        modal:reset->geolocation#removeGeolocationInfo
        submit->form#finishConfirmEndWithN
      "
    }
  ) do |form| %>
    <button
      type="button"
      data-action="previews#openFileSelector"
      class="active-walk-photo-button"
    >
      <i class="fa-regular fa-camera" aria-hidden="true"></i>
      写真を撮る
    </button>

    <p class="mt-2 text-center text-xs leading-relaxed text-[#52645F]">
      見つけたものを撮って、ひらがなで名前を添えます。
    </p>

    <%= form.file_field :image,
      accept: "image/jpeg, image/png",
      capture: "environment",
      class: "hidden",
      data: {
        previews_target: "input",
        action: "change->previews#preview"
      } %>

    <%= render "word_chain_walks/active/modal",
      form: form,
      word_chain_walk: word_chain_walk,
      word_chain_walk_step: word_chain_walk_step %>
  <% end %>
</section>
