<div class="mt-5">
  <% if locations.present? %>
    <div
      id="walk-map-container"
      data-controller="walk-map"
      data-walk-map-positions-value="<%= locations.to_json %>"
    >
      <div
        data-walk-map-target="placeholder"
        class="h-96 w-full overflow-hidden rounded-xl border border-[#C9DBD7] sm:h-[500px]"
      ></div>
    </div>
    <%= turbo_frame_tag "selected_walk_step" do %>
      <div class="mt-4 flex min-h-24 items-center justify-center rounded-xl border border-[#C9E4E5] bg-[#E8F4F5] px-6 py-6">
        <div class="text-center">
          <i class="fa-regular fa-hand-pointer text-lg text-[#204D49]" aria-hidden="true"></i>

          <p class="mt-2 text-sm font-medium leading-relaxed text-[#204D49]">
            地図上のマーカーをタップすると
            <br>
            記録を表示します
          </p>
        </div>
      </div>
    <% end %>
    <p class="mt-3 text-center text-xs text-[#52645F]">
      地図をドラッグして移動できます
    </p>
  <% end %>
</div>
