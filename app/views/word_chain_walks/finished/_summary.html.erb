<header class="text-[#204D49]">
  <h1 class="text-2xl font-bold leading-snug sm:text-3xl">散歩の記録</h1>
  <div class="mt-4 rounded-xl bg-[#E8F4F5] px-4 py-3">
    <p class="text-base">
      <time datetime="<%= word_chain_walk.started_at.iso8601 %>"><%= word_chain_walk.started_at.strftime("%Y年%-m月%-d日 %H:%M") %></time>
      <span class="inline-block">「<%= word_chain_walk.start_char %>」から</span>
    </p>
    <dl class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
      <div class="flex items-baseline gap-2"><dt class="text-sm">つないだことば</dt><dd class="font-bold"><%= word_chain_walk_steps.size %>個</dd></div>
      <div class="flex items-baseline gap-2"><dt class="text-sm">かかった時間</dt><dd class="font-bold"><%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %></dd></div>
    </dl>
  </div>
</header>
