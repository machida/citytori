<div>
  <h1 class="text-center">
    <span class="inline-flex max-w-full items-center justify-center gap-3 text-left sm:gap-4">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#FFF3DF] text-2xl font-bold leading-none text-[#F16B36] sm:h-16 sm:w-16 sm:text-4xl">
        <%= word_chain_walk.start_char %>
      </span>
      <span class="min-w-0 text-2xl font-bold leading-tight tracking-[0.02em] text-[#204D49] sm:text-4xl">
        から始まったしりとり散歩
      </span>
    </span>
  </h1>

  <dl class="mt-6 grid overflow-hidden rounded-2xl border border-[#C9E4E5] bg-[#E8F4F5] text-center min-[420px]:grid-cols-2 min-[420px]:divide-x min-[420px]:divide-[#C9DBD7]">
    <div class="px-5 py-5 min-[420px]:px-6">
      <dt class="flex items-center justify-center gap-2 text-sm font-medium text-[#204D49]">
        <i class="fa-regular fa-comment" aria-hidden="true"></i>
        <span>つないだことばの数</span>
      </dt>
      <dd class="mt-2 text-2xl font-bold leading-none text-[#204D49] sm:text-3xl"><%= word_chain_walk_steps.size %>回</dd>
    </div>

    <div class="border-t border-[#C9DBD7] px-5 py-5 min-[420px]:border-t-0 min-[420px]:px-6">
      <dt class="flex items-center justify-center gap-2 text-sm font-medium text-[#204D49]">
        <i class="fa-regular fa-clock" aria-hidden="true"></i>
        <span>かかった時間</span>
      </dt>
      <dd class="mt-2 text-xl font-bold leading-tight text-[#204D49] sm:text-2xl"><%= formatted_elapsed_time(word_chain_walk.elapsed_seconds) %></dd>
    </div>
  </dl>
</div>
