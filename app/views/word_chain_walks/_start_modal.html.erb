<dialog
  data-walk-start-target="modal"
  class="fixed inset-0 size-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-[#303B3C]/60"
>
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="relative w-full max-w-lg rounded-2xl border border-[#204D49]/10 bg-white p-6 shadow-sm sm:p-8">
      <button
        type="button"
        data-action="walk-start#close"
        aria-label="閉じる"
        class="absolute right-4 top-4 grid size-9 place-items-center rounded-full text-2xl leading-none text-[#52645F] hover:bg-[#E8F4F5] hover:text-[#204D49] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49]"
      >
        ×
      </button>

      <h2 class="pr-8 text-center text-2xl font-bold tracking-tight text-[#204D49]">
        位置情報について
      </h2>

      <div data-walk-start-target="loadingStatus" class="mt-6">
        <%= render "shared/status_notice",
                   variant: :processing,
                   title: "位置情報を取得しています…",
                   message: "散歩の記録に場所を添えられます" %>
      </div>

      <div data-walk-start-target="successStatus" class="mt-6" hidden>
        <%= render "shared/status_notice",
                   variant: :success,
                   title: "位置情報を取得できました",
                   message: "見つけた場所も一緒に記録できます" %>
      </div>

      <div data-walk-start-target="failedStatus" class="mt-6" hidden>
        <%= render "shared/status_notice",
                   variant: :muted_failure,
                   title: "位置情報を取得できませんでした",
                   message: "位置情報なしでこのまま散歩を始められます" %>
      </div>

      <div class="mt-6 space-y-3 text-sm leading-relaxed text-[#303B3C]">
        <p class="flex items-start gap-3">
          <i class="fa-solid fa-check mt-1 text-xs text-[#315D55]" aria-hidden="true"></i>
          <span>見つけた言葉と写真を登録するときに、位置情報も一緒に保存します</span>
        </p>

        <p class="flex items-start gap-3">
          <i class="fa-solid fa-check mt-1 text-xs text-[#315D55]" aria-hidden="true"></i>
          <span>位置情報を取得しなくても、言葉と写真は登録できます</span>
        </p>

        <p class="flex items-start gap-3">
          <i class="fa-solid fa-check mt-1 text-xs text-[#315D55]" aria-hidden="true"></i>
          <span>位置情報の許可は、途中でもブラウザの設定から変更できます</span>
        </p>
      </div>

      <div class="mt-5 text-center">
        <p class="text-xs leading-relaxed text-[#52645F]">
          位置情報を利用するには、ブラウザまたは端末の設定で位置情報の利用を許可してください。
        </p>
      </div>

      <%= button_to "散歩を始める",
                    word_chain_walks_path,
                    method: :post,
                    disabled: true,
                    data: { walk_start_target: "startButton" },
                    class: "mt-6 w-full rounded-xl bg-[#F16B36] px-4 py-3 text-base font-semibold text-white hover:bg-[#CC491C] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#204D49] disabled:cursor-not-allowed disabled:bg-[#A8B5B1]" %>

      <p class="mt-4 text-xs leading-relaxed text-[#52645F]">
        ※位置情報の設定を変更した場合は、このモーダルを一度閉じてもう一度「始める」を押してください。
      </p>
    </div>
  </div>
</dialog>
