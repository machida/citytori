<% if @word_chain_walk.finished? %>
  <% content_for :title, "完了したしりとり散歩" %>
  <% content_for :meta_description, "Citytoriで記録した、#{@word_chain_walk.start_char}から始まるしりとり散歩を振り返れます。" %>
  <%= render "word_chain_walks/finished", word_chain_walk: @word_chain_walk, word_chain_walk_steps: @word_chain_walk_steps, locations: @locations %>
<% else %>
  <% content_for :title, "しりとり散歩中" %>
  <% content_for :meta_description, "Citytoriでしりとり散歩を続けています。次にさがす文字から始まるものを、街で見つけて記録しましょう。" %>
  <%= render "word_chain_walks/active", word_chain_walk: @word_chain_walk, word_chain_walk_steps: @word_chain_walk_steps, word_chain_walk_step: @word_chain_walk_step %>
<% end %>
