<div data-controller="walk-start">
  <div class="home-primary">
    <section
      class="home-content home-start-card"
      aria-labelledby="start-walk-title"
    >
      <p class="home-eyebrow">今日の散歩</p>

      <h1 id="start-walk-title">しりとり散歩をはじめよう</h1>

      <p class="home-start-description">
        街で見つけたものを、写真とことばでつないでいこう。
      </p>

      <%= button_tag "しりとり散歩をはじめる", type: "button", class: "home-primary-cta", data: { action: "walk-start#open"} %>

      <p class="home-location-note">
        「しりとり散歩をはじめる」を押すと、位置情報を利用できるか確認します
      </p>
    </section>
  </div>

  <%= render "word_chain_walks/start_modal" %>
</div>
