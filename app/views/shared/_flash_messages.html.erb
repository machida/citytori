<% if notice.present? %>
  <p
    class="
      mb-5 inline-block rounded-xl border border-[#C9E4E5] bg-[#E8F4F5]
      px-4 py-3 font-medium text-[#204D49]
    "
    id="notice"
  >
    <%= notice %>
  </p>
<% end %>

<% if alert.present? %>
  <p
    class="
      mb-5 inline-block rounded-xl border border-[#B5473C] bg-[#FCEDEA]
      px-4 py-3 font-medium text-[#B5473C]
    "
    id="alert"
  >
    <%= alert %>
  </p>
<% end %>
