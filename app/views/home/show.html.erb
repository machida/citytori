<% if current_user %>
  <% content_for :title, "しりとり散歩" %>
  <% content_for :meta_description, "Citytoriで、しりとり散歩の進行状況やこれまでの記録を確認できます。" %>
  <%= render "logged_in",
             active_word_chain_walk: @active_word_chain_walk,
             finished_word_chain_walks: @finished_word_chain_walks %>
<% else %>
  <% content_for :title, "Citytori" %>
  <% content_for :meta_description, "Citytoriは街で見つけたものを、写真とことばでつないでいく散歩サービスです。" %>
  <%= render "logged_out" %>
<% end %>
