<section class="walk-example" aria-labelledby="walk-example-title">
  <h2 id="walk-example-title" class="landing-section-title">散歩の記録を振り返る</h2>
  <p class="mt-3 text-base leading-7">最初の文字が「き」なら、木を撮って「き」と入力。次も「き」からさがします。</p>
  <ol class="walk-example-grid">
    <% [
      { word: "き", position: "left", time: "14:05", memo: "いつもの道で、大きな木を発見。", next_char: "き" },
      { word: "きく", position: "center", time: "14:12", memo: "道ばたに黄色い菊が咲いていた。", next_char: "く" },
      { word: "くるま", position: "right", time: "14:20", memo: "丸いライトがかわいい車。", next_char: "ま" }
    ].each do |example| %>
      <li class="walk-example-card">
        <%= image_tag "walk-example.webp", alt: "#{example[:word]}の記録例", width: 1200, height: 400, loading: "lazy", class: "walk-example-photo walk-example-photo--#{example[:position]}" %>
        <div class="p-4">
          <p class="text-sm text-[#52645F]"><%= example[:time] %></p>
          <h3 class="mt-1 text-xl font-bold"><%= example[:word] %></h3>
          <p class="mt-2 text-sm leading-6"><%= example[:memo] %></p>
          <p class="mt-3 text-sm font-bold">次は「<%= example[:next_char] %>」</p>
        </div>
      </li>
    <% end %>
  </ol>
  <p class="mt-3 text-sm text-[#52645F]">記録の例です。写真は説明用に生成したイメージです。</p>
</section>
