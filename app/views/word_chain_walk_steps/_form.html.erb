<div id="word_chain_walk_step_errors" data-modal-target="errors">
  <%= render "shared/error_messages", object: form.object %>
</div>

<div>
  <div class="my-5">
    <div
      data-previews-target="preview"
      class="hidden mb-5 overflow-hidden rounded-md bg-gray-100"
    >
      <img
        data-previews-target="image"
        class="block max-h-72 w-full object-contain"
      >
    </div>
  </div>
</div>

<div class="my-5 text-left">
  <div>
    <%= form.hidden_field :latitude, data: { geolocation_target: "latitude" } %>
    <%= form.hidden_field :longitude, data: { geolocation_target: "longitude" } %>

    <div data-geolocation-target="loadingStatus">
      <%= render "shared/status_notice",
                 variant: :processing,
                 title: "位置情報を確認しています…",
                 message: "見つけた場所も一緒に記録します" %>
    </div>

    <div data-geolocation-target="successStatus" hidden>
      <%= render "shared/status_notice",
                 variant: :success,
                 title: "位置情報を取得できました",
                 message: "見つけた場所も一緒に記録します" %>
    </div>

    <div data-geolocation-target="failedStatus" hidden>
      <%= render "shared/status_notice",
                 variant: :muted_failure,
                 title: "位置情報を取得できませんでした",
                 message: "位置情報なしでこのまま記録できます" %>
    </div>

    <div class="mt-2 text-center">
      <%= link_to "位置情報の設定方法を見る",
                  "#",
                  class: "text-sm text-[#315D55] underline" %>
    </div>
  </div>
</div>

<% word_errors = word_chain_walk_step.errors.full_messages_for(:word) %>
<% word_error_id = "word_chain_walk_step_word_error" %>

<div class="my-5 text-left">
  <div class="flex items-baseline gap-2">
    <%= form.label :word, "見つけた言葉" %>
    <span class="text-xs text-gray-600"> ※ ひらがなとのばし棒(ー)のみ入力できます </span>
  </div>

  <%= form.text_field :word,
                      class: [
                        "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                        {
                          "border-gray-400 focus:outline-[#204D49]": word_errors.empty?,
                          "border-[#B5473C] focus:outline-[#B5473C]": word_errors.any?
                        }
                      ],
                      data: { form_target: "word" },
                      placeholder: "こーひーしょっぷ",
                      aria: (word_errors.any? ? { invalid: true, describedby: word_error_id } : {}) %>

  <% if word_errors.any? %>
    <p id="<%= word_error_id %>" class="mt-2 text-sm text-[#B5473C]">
      <%= word_errors.join("、") %>
    </p>
  <% end %>
</div>

<% memo_errors = word_chain_walk_step.errors.full_messages_for(:memo) %>
<% memo_error_id = "word_chain_walk_step_memo_error" %>

<div class="my-5 text-left">
  <%= form.label :memo, "メモ" %>

  <%= form.text_area :memo,
                      rows: 4,
                      class: [
                        "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
                        {
                          "border-gray-400 focus:outline-[#204D49]": memo_errors.empty?,
                          "border-[#B5473C] focus:outline-[#B5473C]": memo_errors.any?
                        }
                      ],
                      aria: (memo_errors.any? ? { invalid: true, describedby: memo_error_id } : {}) %>

  <% if memo_errors.any? %>
    <p id="<%= memo_error_id %>" class="mt-2 text-sm text-[#B5473C]">
      <%= memo_errors.join("、") %>
    </p>
  <% end %>
</div>

<div class="inline">
  <%= form.submit "登録する", class: "inline-block w-full cursor-pointer rounded-md bg-[#F16B36] px-3.5 py-2.5 font-medium text-white hover:bg-[#CC491C] sm:w-auto" %>
</div>
